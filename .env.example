# Modo autónomo para la PC del museo: local
MODO_SERVIDOR=supabase

# Obligatorio únicamente en modo local. Usar una clave larga y privada.
LOCAL_AUTH_SECRET=

DATABASE_URL=
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
# Alternativa para proyectos que todavía usan la clave anon heredada:
