DATABASE_URL=
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
# Alternativa para proyectos que todavía usan la clave anon heredada:
# SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_BUCKET=multimedia

# Funcionamiento local sin Internet. Mantener esta clave privada y con al menos
# 32 caracteres; se puede generar con: npm run generar-secreto-local
MODO_SERVIDOR=local
LOCAL_AUTH_SECRET=

# Sincronizacion opcional entre la instalacion local y el servidor remoto.
# Ambas instalaciones deben tener el mismo secreto. No guardar valores reales
# en este archivo ni subir el archivo .env a GitHub.
SYNC_REMOTE_URL=
SYNC_SHARED_SECRET=
